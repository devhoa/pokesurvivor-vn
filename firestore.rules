rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /saves/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys().hasAll(['save', 'updatedAt', 'v', 'rev'])
        && request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'rev'])
        && request.resource.data.save is map
        && request.resource.data.rev == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['save', 'updatedAt', 'v', 'rev'])
        && request.resource.data.save is map
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.updatedAt == request.time;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasAll(['name', 'lower', 'at'])
        && request.resource.data.keys().hasOnly([
          'name', 'lower', 'at', 'favs', 'title', 'best', 'medals'
        ])
        && request.resource.data.name is string
        && request.resource.data.lower is string
        && request.resource.data.at == request.time;
      allow delete: if owns(userId);
    }

    match /names/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
